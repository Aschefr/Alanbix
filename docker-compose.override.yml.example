# Example of a local production setup (copy to docker-compose.override.yml, which git ignores).
#
# docker-compose.yml is the DEVELOPMENT stack (Vite + backend with auto-reload). This override adds
# the published production image next to it, with your own settings, and keeps the development
# services off (profile "dev"), so a plain "up" only starts production. "pull_policy: always"
# makes every "up" download the latest published version. Updating is then:
#
#   docker compose down && git pull && docker compose up -d
#
# (The development stack can still be started on purpose with: docker compose --profile dev up -d)
services:
  alanbix:
    image: aschefr/alanbix:latest
    pull_policy: always   # every "up" fetches the latest published version
    container_name: alanbix
    restart: unless-stopped
    ports:
      - "41481:41481"
    environment:
      # Ollama server reachable from the container (IP of the machine running Ollama)
      - OLLAMA_HOST=http://192.168.1.10:11434
      # Public address(es) allowed to call the API, comma separated (e.g. a reverse proxy or tunnel domain)
      - CORS_ORIGINS=https://alanbix.example.com
    volumes:
      - ./data:/app/data
    extra_hosts:
      - "host.docker.internal:host-gateway"

  searxng:
    image: searxng/searxng:latest
    container_name: alanbix_searxng
    restart: always
    volumes:
      - ./searxng:/etc/searxng
    ports:
      - "127.0.0.1:8888:8080"

  # Development stack from docker-compose.yml: never started on a production server
  backend:
    profiles: ["dev"]
  frontend:
    profiles: ["dev"]
