# Stage 1: Build Frontend
FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend

# Installer les dependances
COPY frontend/package*.json ./
RUN npm install

# Copier le code source et compiler
COPY frontend/ .
RUN npm run build

# Stage 2: Build Backend & Serve
FROM python:3.11-slim
WORKDIR /app

# ping et traceroute pour les outils de diagnostic reseau de l'assistant IA
RUN apt-get update && apt-get install -y --no-install-recommends iputils-ping traceroute \
    && rm -rf /var/lib/apt/lists/*

# Installer les dependances Python (toutes existent precompilees pour amd64 et arm64 :
# pas besoin d'outils de compilation dans l'image)
COPY backend/requirements.txt backend/requirements-nodeps.txt ./
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.txt && pip install --no-cache-dir --only-binary=:all: --no-deps -r requirements-nodeps.txt

# Copier le code backend
COPY backend/ .

# Copier les métadonnées de la racine (pour écraser tout placeholder temporaire de dev)
COPY VERSION CHANGELOG.md ./

# Copier les fichiers statiques du frontend depuis l'etape 1
COPY --from=frontend-build /app/frontend/build /app/frontend_dist

# Dossier de donnees persistant (Important pour Unraid)
VOLUME ["/app/data"]

# Port expose par FastAPI (41481 = ALABI en leetspeak)
EXPOSE 41481

# Variable d'environnement pour indiquer ou se trouve le frontend compilé
ENV FRONTEND_DIST_DIR=/app/frontend_dist

# Docker (et Unraid, Portainer...) affiche "healthy" tant que l'app repond
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:41481/health', timeout=4)"]

# L'app tourne avec un compte ordinaire (PUID/PGID), pas en root : voir docker-entrypoint.sh
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh && chmod +x /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /app/static/uploads/games && chown -R 1000:1000 /app/static/uploads
ENTRYPOINT ["docker-entrypoint.sh"]

# Lancer l'API
# No per-message compression on websockets: every connection otherwise keeps a ~37 KB zlib context,
# and connections cut abruptly (phones going to sleep) left them in memory until the swap filled up
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "41481", "--ws-per-message-deflate", "false"]
